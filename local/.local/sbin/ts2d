#!/usr/bin/env python3

#!/usr/bin/env python3
import sys
from datetime import datetime

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    ts = float(line)
    if ts > 1e11:  # 超过 1e11 视为毫秒
        ts /= 1000
    print(datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S"))
