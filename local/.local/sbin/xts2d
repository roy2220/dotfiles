#!/usr/bin/env python3
import sys
from datetime import datetime

date_only = "-d" in sys.argv[1:]

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    ts = int(line, 16)
    if ts > 1e11:  # 超过 1e11 视为毫秒
        ts /= 1000
    if date_only:
        format = "%Y-%m-%d"
    else:
        format = "%Y-%m-%d %H:%M:%S"
    print(datetime.fromtimestamp(ts).strftime(format))
